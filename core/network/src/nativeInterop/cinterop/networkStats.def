package = com.jagdeep.network.speed.cinterop
headers = ifaddrs.h net/if.h net/if_var.h sys/socket.h string.h
---
#include <stdint.h>
#include <ifaddrs.h>
#include <net/if.h>
#include <net/if_var.h>
#include <sys/socket.h>

static inline int cn_should_count_network_interface(struct ifaddrs *interface) {
    if (interface == 0 || interface->ifa_addr == 0 || interface->ifa_data == 0) {
        return 0;
    }
    if (interface->ifa_addr->sa_family != AF_LINK) {
        return 0;
    }
    if ((interface->ifa_flags & IFF_UP) == 0 || (interface->ifa_flags & IFF_LOOPBACK) != 0) {
        return 0;
    }

    const char *name = interface->ifa_name;
    if (name == 0) {
        return 0;
    }
    if (strncmp(name, "lo", 2) == 0 ||
        strncmp(name, "awdl", 4) == 0 ||
        strncmp(name, "llw", 3) == 0 ||
        strncmp(name, "utun", 4) == 0 ||
        strncmp(name, "bridge", 6) == 0 ||
        strncmp(name, "stf", 3) == 0) {
        return 0;
    }

    return 1;
}

static inline int64_t cn_network_bytes(int sent) {
    struct ifaddrs *interfaces = 0;
    if (getifaddrs(&interfaces) != 0) {
        return -1;
    }

    int64_t bytes = 0;
    struct ifaddrs *cursor = interfaces;
    while (cursor != 0) {
        if (cn_should_count_network_interface(cursor)) {
            struct if_data *data = (struct if_data *)cursor->ifa_data;
            bytes += sent ? data->ifi_obytes : data->ifi_ibytes;
        }
        cursor = cursor->ifa_next;
    }
    freeifaddrs(interfaces);
    return bytes;
}

static inline int64_t cn_network_received_bytes(void) {
    return cn_network_bytes(0);
}

static inline int64_t cn_network_sent_bytes(void) {
    return cn_network_bytes(1);
}
